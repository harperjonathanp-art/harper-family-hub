// The Hub's backend. Cloudflare (Workers Builds) deploys it from this repo on
// every push to main. Only worker/ is deployed; the rest of the repo is the
// GitHub Pages site. See worker/README.md.
{
  // Named for the push relay it began as; the name is its address, so it stays.
  "name": "family-hub-push",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  // Keep the text variables set in the Cloudflare dashboard (secrets are always kept).
  "keep_vars": true,
  // The Hub's database. With no ID given, the first deploy made it and linked it.
  "d1_databases": [{ "binding": "DB" }],
  // The timer: every five minutes (worker/hub/api.js).
  "triggers": { "crons": ["*/5 * * * *"] }
}
